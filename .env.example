# Autonomous Bug Hunter: environment template.
# `node scripts/dev.mjs` creates .env on its first run with random local keys; Docker Compose reads the same file.
# Copy this file to .env only if you want to set values yourself. .env is git-ignored: never commit it.

# --- Local keys (required; dev.mjs generates them) ------------------------------------------------------------
# Admin and test-reset key of the demo apps, also the simulators' harness key.
DEMO_SHOP_KEY=
# API token of the Jira and Confluence simulators.
SIM_TOKEN=

# --- Model providers (optional: no-AI hunts need none) ----------------------------------------------------------
# Bring your own key.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# A local Ollama server (default http://localhost:11434):
# Models__OllamaUrl=http://localhost:11434

# --- Securing the API ------------------------------------------------------------------------------------------
# Set this before anyone but you can reach the API: every /api call then needs it (X-Api-Key or Bearer).
BUGHUNTER_API_KEY=

# --- Storage (optional) ----------------------------------------------------------------------------------------
# File (default, no dependencies) or Postgres (shared by several API instances).
# Storage__Provider=File
# With Docker Compose and --profile postgres, set the database password:
# POSTGRES_PASSWORD=
# Outside Docker, the connection string:
# ConnectionStrings__BugHunter=Host=localhost;Database=bughunter;Username=bughunter;Password=<your password>

# --- Browser worker (optional) ---------------------------------------------------------------------------------
# HEADED=1 shows the browser window while hunting.
# HEADED=0
